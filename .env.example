# O token do Blob é criado e conectado automaticamente pela Vercel.
BLOB_READ_WRITE_TOKEN=

# Use credenciais privadas no deploy público.
ADMIN_EMAIL=dono@bardonardo.local
# Mínimo de 12 caracteres. Não publique a senha real.
ADMIN_PASSWORD=
# Mínimo de 32 caracteres aleatórios.
ADMIN_SESSION_SECRET=

# Opcionais: o servidor detecta o domínio da requisição automaticamente.
BAR_STORE_BLOB_PATH=bar-do-nardo/store.json
PUBLIC_BASE_URL=
